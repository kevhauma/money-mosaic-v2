{
  "name": "money-mosaic-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-hosting backend for Money Mosaic: Express + SQLite + Drizzle. Installed and run separately from the Angular workspace (TICKET-SRV-01).",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "migrate": "drizzle-kit generate && tsx src/migrate.ts",
    "migrate:generate": "drizzle-kit generate",
    "migrate:apply": "tsx src/migrate.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "token:create": "tsx src/token.ts create",
    "token:list": "tsx src/token.ts list",
    "token:revoke": "tsx src/token.ts revoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.0.8"
  }
}
